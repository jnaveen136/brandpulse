# Copy to .env and fill in. Never commit .env.

# Which LLM answers questions: "gemini", "ollama" or "offline" (no LLM, template answers only)
LLM_PROVIDER=offline

# Gemini (free tier key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (runs locally: https://ollama.com, then `ollama pull qwen2.5:7b`)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Path to the source workbook
BRANDPULSE_DATA=data/raw/Brand_Intelligence_Accelerator_Dataset_v1.xlsx
